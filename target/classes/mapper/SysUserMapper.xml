<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.barter.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.barter.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="student_no" property="studentNo"/>
        <result column="department" property="department"/>
        <result column="avatar" property="avatar"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 登录：需要密码 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_user WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.barter.entity.SysUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, phone, student_no, department, avatar, status)
        VALUES (#{username}, #{password}, #{realName}, #{phone}, #{studentNo}, #{department}, #{avatar}, #{status})
    </insert>

    <!-- 管理后台：不返回密码 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, username, real_name, phone, student_no, department, avatar, status, create_time, update_time
        FROM sys_user ORDER BY id DESC
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM sys_user
    </select>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

    <update id="updatePassword">
        UPDATE sys_user SET password = #{password}, update_time = NOW() WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE sys_user SET status = #{status}, update_time = NOW() WHERE id = #{id}
    </update>

    <update id="updateById" parameterType="com.barter.entity.SysUser">
        UPDATE sys_user
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="department != null">department = #{department},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
