<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.barter.mapper.ReportMapper">

    <resultMap id="BaseResultMap" type="com.barter.entity.Report">
        <id column="id" property="id"/>
        <result column="reporter_id" property="reporterId"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="reason" property="reason"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="handle_time" property="handleTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.barter.entity.Report" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO report (reporter_id, target_type, target_id, reason, description, status)
        VALUES (#{reporterId}, #{targetType}, #{targetId}, #{reason}, #{description}, 0)
    </insert>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM report ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT * FROM report WHERE status = #{status} ORDER BY create_time DESC
    </select>

    <update id="updateStatus">
        UPDATE report SET status = #{status}, handle_time = NOW() WHERE id = #{id}
    </update>

</mapper>
