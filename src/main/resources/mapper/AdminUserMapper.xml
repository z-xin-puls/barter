<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.barter.mapper.AdminUserMapper">

    <resultMap id="BaseResultMap" type="com.barter.entity.AdminUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="avatar" property="avatar"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 登录：需要密码 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT * FROM admin_user WHERE username = #{username}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM admin_user WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.barter.entity.AdminUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_user (username, password, real_name, phone, avatar, status)
        VALUES (#{username}, #{password}, #{realName}, #{phone}, #{avatar}, #{status})
    </insert>

    <!-- 管理后台：不返回密码 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, username, real_name, phone, avatar, status, create_time, update_time
        FROM admin_user ORDER BY id DESC
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM admin_user
    </select>

    <delete id="deleteById">
        DELETE FROM admin_user WHERE id = #{id}
    </delete>

    <update id="updatePassword">
        UPDATE admin_user SET password = #{password}, update_time = NOW() WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE admin_user SET status = #{status}, update_time = NOW() WHERE id = #{id}
    </update>

</mapper>
